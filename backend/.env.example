# ============================================================
# WMS Geology — backend environment variables
# ============================================================
# Копируй в backend/.env и правь под своё окружение.
# Файл .env НЕ коммитится (см. .gitignore).
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Database (PostgreSQL) ---
POSTGRES_DB=wms_geology
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=wms_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Альтернативно — одной строкой:
# DATABASE_URL=postgresql://wms_user:wms_password@localhost:5432/wms_geology

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# --- CORS (для dev-клиентов) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- QR ---
# Базовый URL, который попадает в QR-код (payload)
QR_BASE_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=DEBUG

# --- File uploads ---
# Максимальный размер загружаемого файла (МБ)
MAX_UPLOAD_SIZE_MB=10